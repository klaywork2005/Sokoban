<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <!-- Maven coordinates identify this project and its built artifact. -->
    <groupId>org.columpio</groupId>
    <artifactId>Sokoban</artifactId>
    <version>1.0.0</version>
    <name>Sokoban</name>
    <description>A Swing Sokoban game.</description>

    <!-- Compile against Java 21 APIs and read source files as UTF-8. -->
    <properties>
        <maven.compiler.release>21</maven.compiler.release>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    </properties>
    <dependencies>
        <!-- JLayer decodes the MP3 background music, which Java cannot play on its own. -->
        <dependency>
            <groupId>javazoom</groupId>
            <artifactId>jlayer</artifactId>
            <version>1.0.1</version>
        </dependency>
        <!-- JUnit supplies test annotations and assertions only for test code. -->
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <version>5.10.2</version>
            <scope>test</scope>
        </dependency>
    </dependencies>
    <build>
        <plugins>
            <!-- Pin the compiler so Maven consistently uses the Java release above. -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <version>3.15.0</version>
            </plugin>
            <!-- Discover and run the JUnit tests during mvn test. -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <version>3.2.5</version>
            </plugin>
            <!-- Launch the Swing entry point with mvn exec:java after compilation. -->
            <plugin>
                <groupId>org.codehaus.mojo</groupId>
                <artifactId>exec-maven-plugin</artifactId>
                <version>3.2.0</version>
                <configuration>
                    <mainClass>sokoban.Main</mainClass>
                </configuration>
            </plugin>
            <!--
                mvn package also builds target/sokoban.jar: one file with the game, its levels,
                artwork, music and the JLayer library inside. Run it with: java -jar target/sokoban.jar
            -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-assembly-plugin</artifactId>
                <version>3.7.1</version>
                <configuration>
                    <!-- The manifest tells "java -jar" which class holds main(). -->
                    <archive>
                        <manifest>
                            <mainClass>sokoban.Main</mainClass>
                        </manifest>
                    </archive>
                    <!-- jar-with-dependencies copies our classes and every library into one jar. -->
                    <descriptorRefs>
                        <descriptorRef>jar-with-dependencies</descriptorRef>
                    </descriptorRefs>
                    <!-- Name the file sokoban.jar, and keep it apart from the plain project jar. -->
                    <finalName>sokoban</finalName>
                    <appendAssemblyId>false</appendAssemblyId>
                    <attach>false</attach>
                </configuration>
                <executions>
                    <execution>
                        <id>make-runnable-jar</id>
                        <phase>package</phase>
                        <goals>
                            <goal>single</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
